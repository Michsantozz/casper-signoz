{
 "id": "casper-agent-llm-observability",
 "locked": false,
 "orgId": "",
 "name": "CasperAgent \u2014 Agent & LLM Observability",
 "tags": [
  "casper",
  "llm",
  "agent",
  "hackathon"
 ],
 "schemaVersion": "v6",
 "source": "",
 "spec": {
  "display": {
   "name": "CasperAgent \u2014 Agent & LLM Observability",
   "description": "Agent-native observability for CasperAgent (Mastra + Fireworks) over OTLP traces. Built on the gen_ai.* semantic conventions the Mastra OtelExporter emits: gen_ai.request.model, gen_ai.usage.input_tokens/output_tokens, plus mastra.span.type. LLM panels filter on mastra.span.type = 'model_generation' (the exact discriminator our spans carry). COST is derived by formula (tokens x price) because the exporter does not emit a cost attribute \u2014 see the PRICE PLACEHOLDER note on the cost panels."
  },
  "variables": [],
  "panels": {
   "11111111-1111-1111-1111-111111111111": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "LLM calls",
      "description": "Total model generations (mastra.span.type = model_generation)."
     },
     "plugin": {
      "kind": "signoz/NumberPanel",
      "spec": {
       "visualization": {
        "timePreference": "global_time"
       }
      }
     },
     "queries": [
      {
       "kind": "scalar",
       "spec": {
        "plugin": {
         "kind": "signoz/CompositeQuery",
         "spec": {
          "queries": [
           {
            "type": "builder_query",
            "spec": {
             "name": "A",
             "signal": "traces",
             "stepInterval": 60,
             "disabled": false,
             "filter": {
              "expression": "mastra.span.type = 'model_generation'"
             },
             "having": {
              "expression": ""
             },
             "aggregations": [
              {
               "expression": "count()"
              }
             ]
            }
           }
          ]
         }
        }
       }
      }
     ]
    }
   },
   "22222222-2222-2222-2222-222222222222": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "Total tokens",
      "description": "Sum of input + output tokens across all model generations."
     },
     "plugin": {
      "kind": "signoz/NumberPanel",
      "spec": {
       "visualization": {
        "timePreference": "global_time"
       }
      }
     },
     "queries": [
      {
       "kind": "scalar",
       "spec": {
        "plugin": {
         "kind": "signoz/CompositeQuery",
         "spec": {
          "queries": [
           {
            "type": "builder_query",
            "spec": {
             "name": "A",
             "signal": "traces",
             "stepInterval": 60,
             "disabled": false,
             "filter": {
              "expression": "mastra.span.type = 'model_generation'"
             },
             "having": {
              "expression": ""
             },
             "aggregations": [
              {
               "expression": "sum(gen_ai.usage.input_tokens)"
              },
              {
               "expression": "sum(gen_ai.usage.output_tokens)"
              }
             ]
            }
           }
          ]
         }
        }
       }
      }
     ]
    }
   },
   "33333333-3333-3333-3333-333333333333": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "Est. cost (USD)",
      "description": "Derived cost = input_tokens * PRICE_IN + output_tokens * PRICE_OUT. PRICE PLACEHOLDER: 0.0000009 USD/token (=$0.90 / 1M) for both, until real Fireworks glm-5p2 rates are set. Edit the two formula constants below to your actual per-token price."
     },
     "plugin": {
      "kind": "signoz/NumberPanel",
      "spec": {
       "visualization": {
        "timePreference": "global_time"
       }
      }
     },
     "queries": [
      {
       "kind": "scalar",
       "spec": {
        "plugin": {
         "kind": "signoz/CompositeQuery",
         "spec": {
          "queries": [
           {
            "type": "builder_query",
            "spec": {
             "name": "A",
             "signal": "traces",
             "stepInterval": 60,
             "disabled": true,
             "filter": {
              "expression": "mastra.span.type = 'model_generation'"
             },
             "having": {
              "expression": ""
             },
             "aggregations": [
              {
               "expression": "sum(gen_ai.usage.input_tokens)"
              }
             ]
            }
           },
           {
            "type": "builder_query",
            "spec": {
             "name": "B",
             "signal": "traces",
             "stepInterval": 60,
             "disabled": true,
             "filter": {
              "expression": "mastra.span.type = 'model_generation'"
             },
             "having": {
              "expression": ""
             },
             "aggregations": [
              {
               "expression": "sum(gen_ai.usage.output_tokens)"
              }
             ]
            }
           },
           {
            "type": "builder_formula",
            "spec": {
             "name": "F1",
             "expression": "A * 0.0000009 + B * 0.0000009",
             "disabled": false,
             "legend": "est. cost (USD)"
            }
           }
          ]
         }
        }
       }
      }
     ]
    }
   },
   "44444444-4444-4444-4444-444444444444": {

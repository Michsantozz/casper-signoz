   "66666666-6666-6666-6666-666666666666": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "Tokens over time by model",
      "description": "Input + output tokens per gen_ai.request.model."
     },
     "plugin": {
      "kind": "signoz/TimeSeriesPanel",
      "spec": {
       "visualization": {
        "timePreference": "global_time"
       }
      }
     },
     "queries": [
      {
       "kind": "time_series",
       "spec": {
        "plugin": {
         "kind": "signoz/CompositeQuery",
         "spec": {
          "queries": [
           {
            "type": "builder_query",
            "spec": {
             "name": "A",
             "signal": "traces",
             "stepInterval": 60,
             "disabled": false,
             "filter": {
              "expression": "mastra.span.type = 'model_generation'"
             },
             "groupBy": [
              {
               "name": "gen_ai.request.model",
               "fieldDataType": "string",
               "fieldContext": "tag"
              }
             ],
             "legend": "in {{gen_ai.request.model}}",
             "having": {
              "expression": ""
             },
             "aggregations": [
              {
               "expression": "sum(gen_ai.usage.input_tokens)"
              }
             ]
            }
           },
           {
            "type": "builder_query",
            "spec": {
             "name": "B",
             "signal": "traces",
             "stepInterval": 60,
             "disabled": false,
             "filter": {
              "expression": "mastra.span.type = 'model_generation'"
             },
             "groupBy": [
              {
               "name": "gen_ai.request.model",
               "fieldDataType": "string",
               "fieldContext": "tag"
              }
             ],
             "legend": "out {{gen_ai.request.model}}",
             "having": {
              "expression": ""
             },
             "aggregations": [
              {
               "expression": "sum(gen_ai.usage.output_tokens)"
              }
             ]
            }
           }
          ]
         }
        }
       }
      }
     ]
    }

{
  "alert": "CasperAgent — LLM p95 latency high",
  "alertType": "TRACES_BASED_ALERT",
  "ruleType": "threshold_rule",
  "schemaVersion": "v2alpha1",
  "description": "p95 latency of LLM generations (mastra.span.type = model_generation) is above the target. Investigate the Fireworks endpoint, prompt size, or upstream contention. Value is in nanoseconds (duration_nano).",
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "traces",
            "stepInterval": 60,
            "disabled": false,
            "filter": {
              "expression": "mastra.span.type = 'model_generation' AND casper.self_instrumented = true"
            },
            "having": {
              "expression": ""
            },
            "aggregations": [
              {
                "expression": "p95(duration_nano)"
              }
            ]
          }
        }
      ],
      "panelType": "graph",
      "queryType": "builder",
      "unit": "ns"
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "critical",
          "target": 30000000000,
          "targetUnit": "ns",
          "matchType": "at_least_once",
          "op": "above",
          "channels": [
            "casper-default"
          ]
        }
      ]
    }
  },
  "labels": {
    "severity": "critical",
    "component": "llm"
  },
  "annotations": {
    "summary": "LLM p95 latency above threshold ({{$threshold}} ns)",
    "description": "p95 model_generation latency reached {{$value}} ns."
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "5m",
      "frequency": "1m"
    }
  },
  "notificationSettings": {
    "groupBy": [
      "gen_ai.request.model"
    ],
    "renotify": {
      "enabled": true,
      "interval": "1h",
      "alertStates": [
        "firing"
      ]
    },
    "usePolicy": false
  },
  "disabled": false
}
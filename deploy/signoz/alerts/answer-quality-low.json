{
  "alert": "CasperAgent — answer coverage low",
  "alertType": "TRACES_BASED_ALERT",
  "ruleType": "threshold_rule",
  "schemaVersion": "v2alpha1",
  "description": "Average answer-COVERAGE score (mastra.span.type = 'eval', mastra.eval.score, 0..1) dropped below target. The score is @mastra/evals `completeness`: covered_elements / total_input_elements over the elements extracted from the request — i.e. how much of the question the answer addressed, NOT whether it was correct. So this rule detects a DROP (truncation cap, degraded retrieval, prompt/model regression), and must not be read as 'the agent got dumber'. Deterministic and zero-LLM, so it is cheap to watch continuously. Threshold is baseline-relative: re-tune 0.4 against this service's own observed floor before trusting it.",
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "traces",
            "stepInterval": 60,
            "disabled": false,
            "filter": {
              "expression": "service.name = 'casper-assistant' AND deployment.environment.name = 'production' AND mastra.span.type = 'eval'"
            },
            "having": {
              "expression": ""
            },
            "aggregations": [
              {
                "expression": "avg(mastra.eval.score)"
              }
            ]
          }
        }
      ],
      "panelType": "graph",
      "queryType": "builder",
      "unit": ""
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "warning",
          "target": 0.4,
          "targetUnit": "",
          "matchType": "at_least_once",
          "op": "below",
          "channels": [
            "casper-default"
          ]
        }
      ]
    }
  },
  "labels": {
    "severity": "warning",
    "component": "quality"
  },
  "annotations": {
    "summary": "Agent answer coverage below threshold ({{$threshold}})",
    "description": "avg completeness score reached {{$value}} (0..1)."
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "15m",
      "frequency": "5m"
    }
  },
  "notificationSettings": {
    "groupBy": [
      "mastra.eval.scorer"
    ],
    "renotify": {
      "enabled": true,
      "interval": "1h",
      "alertStates": [
        "firing"
      ]
    },
    "usePolicy": false
  },
  "disabled": false
}

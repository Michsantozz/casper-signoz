{
  "funnel_name": "CasperAgent — plan → tool → generate",
  "description": "Agent pipeline funnel over Mastra's native trace spans for the PRODUCT agent users actually talk to (Casper Assistant): how many agent runs reach tool execution, and how many of those reach the final generation. Conversion / drop-off per phase — observability that only makes sense for an agent. Steps match by service_name + span_name on the same trace, in temporal order (see README for the span_name caveat).",
  "steps": [
    {
      "step_order": 1,
      "name": "invoke_agent",
      "service_name": "casper-assistant",
      "span_name": "invoke_agent Casper Assistant",
      "filters": {
        "op": "AND",
        "items": [
          { "key": { "key": "mastra.span.type", "dataType": "string", "type": "tag" }, "op": "=", "value": "agent_run" }
        ]
      }
    },
    {
      "step_order": 2,
      "name": "tool_call",
      "service_name": "casper-assistant",
      "span_name": "execute_tool list_calendar_events",
      "filters": {
        "op": "AND",
        "items": [
          { "key": { "key": "mastra.span.type", "dataType": "string", "type": "tag" }, "op": "=", "value": "tool_call" }
        ]
      }
    },
    {
      "step_order": 3,
      "name": "generate",
      "service_name": "casper-assistant",
      "span_name": "model_inference Casper Assistant",
      "filters": {
        "op": "AND",
        "items": [
          { "key": { "key": "mastra.span.type", "dataType": "string", "type": "tag" }, "op": "=", "value": "model_inference" }
        ]
      }
    }
  ]
}

/node_modules
/.pnpm-store
/.next
/out
/build
# Todas as variantes de env (.env, .env.local, .env.production, .env.staging…)
# ficam fora do repo. Só .env.example (sem segredo) é versionado.
.env
.env.*
!.env.example
*.pem
agent-secret.pem
.DS_Store
*.tsbuildinfo
next-env.d.ts

# Playwright artifacts (test run output / reports) — não são código do projeto.
/test-results
/playwright-report
/videos

# Mídia local (gravações de reunião baixadas para teste) — pesada, nunca vai
# pro repo. Use object storage (S3/MinIO) para mídia real.
*.mp4
*.mov
*.webm

# Docs de trabalho/scratch — NÃO vão pro repo. Mantemos versionados apenas os
# READMEs (README.md, tests/README.md), o CLAUDE.md e as skills reais
# (.claude/skills/**). Todo o resto de .md de referência/scratch fica ignorado.
/zdocs
/docs
/.firecrawl
/CASPER_SDK.md

# Material de apresentação do vídeo demo (roteiro, narração, render). Não é
# código do projeto.
/demo

# As composições Remotion que geraram o vídeo de submissão. Ficam no disco para
# poder rebuildar, mas fora do repo: é material de apresentação, não runtime do
# produto — nada em src/ importa daqui, e os assets que elas carregam vivem em
# zdocs/video-production/ (também ignorado). Ver o README de lá para rebuildar.
/src/remotion

# Ferramentas locais do Claude Code (skills, settings) — não são código do projeto.
/.claude
/.agents
/.playwright-mcp
/skills-lock.json
